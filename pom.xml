<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>


    <!--
       PARENT — Spring Boot BOM (Bill of Materials)
       ─────────────────────────────────────────────
       Al heredar del parent de Spring Boot, él gestiona automáticamente
       las versiones de TODAS sus dependencias.

       Sin parent: tenés que saber que Spring MVC 6.1.4 es compatible con
       Jackson 2.16.1, que es compatible con Tomcat 10.1.19...
       (conflictos de versiones: el peor dolor de cabeza de Java)

       Con parent: solo elegís la versión de Spring Boot (3.3.5)
       y él sincroniza todo lo demás. ✅
   -->

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.4.6</version>
        <relativePath/> <!-- lookup parent from repository -->
    </parent>


    <!--     Identidad del Proyecto-->
    <groupId>com.app</groupId>
    <artifactId>smartdoc</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <name>smartdoc</name>
    <description>AI Platflorm - Documents Analisis - AI/AWS</description>
    <url/>
    <licenses>
        <license/>
    </licenses>
    <developers>
        <developer/>
    </developers>
    <scm>
        <connection/>
        <developerConnection/>
        <tag/>
        <url/>
    </scm>

    <!--
       properties — Variables reutilizables en este archivo.
       Si hay que actualizar una versión, se cambia acá y aplica en todos lados.
   -->

    <properties>
        <java.version>21</java.version>
        <!-- Spring AI M6: contiene los starters usados en este proyecto -->
        <spring-ai.version>1.0.0-M6</spring-ai.version>

        <!-- AWS SDK v2: versión más reciente al momento de escribir esta guía -->
        <awsjavasdk.version>2.25.11</awsjavasdk.version>
    </properties>

    <!--*
         dependencyManagement — Gestión centralizada de versiones
         ─────────────────────────────────────────────────────────
         DIFERENCIA CLAVE con <dependencies>:
           dependencyManagement → DECLARA versiones pero NO descarga nada
           dependencies         → SÍ descarga las librerías

         Acá metemos los BOMs de Spring AI y AWS SDK para que
         sus dependencias no necesiten declarar versión.
     -->
    <dependencyManagement>
        <dependencies>
            <!--!
                BOM de Spring AI
                Define las versiones de TODAS las librerías de Spring AI.
                Sin esto, tendrías que poner <version> en cada dependencia de AI.
            -->
            <dependency>
                <groupId>org.springframework.ai</groupId>
                <artifactId>spring-ai-bom</artifactId>
                <version>${spring-ai.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

            <!--!
                BOM de AWS SDK para Java v2
                El SDK de AWS tiene MUCHAS dependencias (S3, DynamoDB, Lambda, etc.)
                El BOM sincroniza todas esas versiones para que sean compatibles entre sí.
            -->
            <dependency>
                <groupId>software.amazon.awssdk</groupId>
                <artifactId>bom</artifactId>
                <version>${awsjavasdk.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>

    </dependencyManagement>

    <repositories>
        <repository>
            <id>spring-milestone</id>
            <name>Spring Milestone</name>
            <url>https://repo.spring.io/milestone</url>
        </repository>
    </repositories>

    <dependencies>

        <!-- ================================================================ -->
        <!-- ! SPRING BOOT — EL NÚCLEO                                         -->
        <!-- ================================================================ -->


        <!--
            spring-boot-starter-web
            El starter más importante para APIs REST.
            Un "starter" agrupa varias librerías relacionadas.
            Incluye automáticamente:
              - Spring MVC: @RestController, @GetMapping, @PostMapping, etc.
              - Tomcat: el servidor web (corre en el puerto 8080)
              - Jackson: convierte objetos Java ↔ JSON automáticamente
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!--
            spring-boot-starter-webflux
            Incluye: Project Reactor (Flux, Mono), servidor Netty reactivo.
            Necesario para: streaming de respuestas AI con Flux<String>.
            Se puede usar junto con starter-web sin problema — no reemplaza a Tomcat.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webflux</artifactId>
        </dependency>

        <!--
           spring-boot-starter-data-jpa
           Incluye: Hibernate (ORM), Spring Data (repositorios), transacciones.
           Permite: @Entity, @Repository, JpaRepository<T, ID>.
           Simplifica enormemente el acceso a base de datos relacionales.
       -->

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>

        <!--
            spring-boot-starter-validation
            Incluye: Bean Validation (Jakarta), Hibernate Validator.
            Permite: @NotBlank, @Size, @Email, @Min, @Max en DTOs.
            @Valid en @RequestBody activa estas validaciones automáticamente.
        -->

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!--
           spring-boot-starter-cache
           Incluye: Spring Cache abstraction.
           Permite: @Cacheable, @CacheEvict, @CachePut en métodos.
           Evita llamadas repetidas a la API de AI (que cuestan dinero y tiempo).
       -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-cache</artifactId>
        </dependency>

        <!--
           spring-boot-starter-aop
           Programación Orientada a Aspectos — requerida para que @Cacheable y @CacheEvict funcionen.
           Spring usa proxies AOP para interceptar llamadas a métodos anotados.
           Analogy: es como un "guardia de seguridad" que intercepta el llamado al método
           y decide si ejecutarlo o devolver el resultado cacheado.
           También usada por @Transactional y @Scheduled internamente.
       -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-aop</artifactId>
        </dependency>

        <!--
            spring-boot-starter-actuator
            Expone endpoints HTTP de monitoreo:
              /actuator/health  → ¿está viva la app?
              /actuator/metrics → métricas de JVM, HTTP, etc.
              /actuator/info    → información del build
            En producción se conecta a Prometheus/Grafana para dashboards.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>


        <!--
           spring-boot-starter-security
           Framework de seguridad de Spring Boot.
           En cuanto está en el classpath, TODAS las rutas requieren autenticación
           (por eso necesitamos SecurityConfig para configurar las rutas públicas).
           Incluye: filtros de seguridad, contexto de autenticación, CSRF, etc.
       -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>

        <!--
           jjwt-api / jjwt-impl / jjwt-jackson
           Librería para trabajar con JWT (JSON Web Tokens).
           jjwt-api:     las interfaces y clases principales (para compilar)
           jjwt-impl:    la implementación (necesaria en runtime)
           jjwt-jackson: integración con Jackson para parsear los claims (runtime)
       -->
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-api</artifactId>
            <version>0.12.6</version>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-impl</artifactId>
            <version>0.12.6</version>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-jackson</artifactId>
            <version>0.12.6</version>
            <scope>runtime</scope>
        </dependency>

        <!--
            spring-boot-devtools
            Solo activo en desarrollo, NO en producción.
            Hot reload: cuando cambiás el código, la app se reinicia sola.
            scope=runtime: solo cuando la app corre, no al compilar.
            optional=true: no se propaga a otros proyectos.
        -->

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-devtools</artifactId>
            <scope>runtime</scope>
            <optional>true</optional>
        </dependency>

        <!-- ================================================================ -->
        <!--! BASE DE DATOS                                                    -->
        <!-- ================================================================ -->

        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- ================================================================ -->
        <!--! SPRING AI — INTELIGENCIA ARTIFICIAL                             -->
        <!-- ================================================================ -->

        <!--
            spring-ai-openai-spring-boot-starter
            Integración con OpenAI (GPT-4o, GPT-4o-mini, etc.).
            Configura automáticamente el ChatClient y el EmbeddingModel.
            Con el BOM declarado arriba, no necesita <version>.

            Para cambiar a AWS Bedrock: comentar esto y habilitar el de Bedrock.
        -->
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-openai-spring-boot-starter</artifactId>
            <version>${spring-ai.version}</version>
        </dependency>

        <!--
            spring-ai-pgvector-store-spring-boot-starter
            Vector Store usando la extensión pgvector de PostgreSQL.
            Permite guardar y buscar embeddings directamente en PostgreSQL.
            Alternativa a bases vectoriales separadas como Pinecone o Chroma.
            Ventaja: un solo sistema de base de datos para todo.
        -->
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-pgvector-store-spring-boot-starter</artifactId>
            <version>${spring-ai.version}</version>
        </dependency>

        <!--
            spring-ai-pdf-document-reader
            Lector de PDFs para Spring AI.
            Usa Apache PDFBox internamente para extraer texto de PDFs.
            Permite dividir PDFs en páginas o secciones.
        -->

        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-pdf-document-reader</artifactId>
            <version>${spring-ai.version}</version>
        </dependency>

        <!--
            spring-ai-tika-document-reader
            Lector de múltiples formatos usando Apache Tika.
            Soporta: PDF, Word (.docx), Excel (.xlsx), HTML, texto plano, etc.
            Si Tika puede leerlo, Spring AI puede procesarlo para RAG.
        -->

        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-tika-document-reader</artifactId>
            <version>${spring-ai.version}</version>
        </dependency>


        <!-- ================================================================ -->
        <!--! AWS SDK v2 — SERVICIOS DE AMAZON                               -->
        <!-- ================================================================ -->

        <!--
           s3 — Amazon Simple Storage Service
           Para: subir archivos, descargarlos, listar buckets, generar URLs firmadas.
           Clases: S3Client, PutObjectRequest, GetObjectRequest, etc.
           En nuestro proyecto: guardamos los PDFs subidos por los usuarios.
       -->
        <dependency>
            <groupId>software.amazon.awssdk</groupId>
            <artifactId>s3</artifactId>
        </dependency>

        <!--
            sqs — Amazon Simple Queue Service
            Para: enviar mensajes a una cola, recibir y procesar mensajes.
            Clases: SqsClient, SendMessageRequest, ReceiveMessageRequest, etc.
            En nuestro proyecto: trigger asíncrono cuando llega un nuevo documento.
        -->

        <dependency>
            <groupId>software.amazon.awssdk</groupId>
            <artifactId>sqs</artifactId>
        </dependency>

        <!--
            sns — Amazon Simple Notification Service
            Para: notificar a múltiples suscriptores cuando pasa algo.
            Clases: SnsClient, PublishRequest, SubscribeRequest, etc.
            En nuestro proyecto: notificar cuando el procesamiento termina.
        -->
        <dependency>
            <groupId>software.amazon.awssdk</groupId>
            <artifactId>sns</artifactId>
        </dependency>

        <!--
           ec2 — Amazon Elastic Compute Cloud
           Para: gestionar instancias virtuales (crear, iniciar, detener, terminar).
           Clases: Ec2Client, RunInstancesRequest, DescribeInstancesRequest, etc.
       -->
        <dependency>
            <groupId>software.amazon.awssdk</groupId>
            <artifactId>ec2</artifactId>
        </dependency>

        <!--
           autoscaling — Amazon EC2 Auto Scaling
           Para: crear grupos de Auto Scaling, políticas de escalado.
           Clases: AutoScalingClient, CreateAutoScalingGroupRequest, etc.
       -->

        <dependency>
            <groupId>software.amazon.awssdk</groupId>
            <artifactId>autoscaling</artifactId>
        </dependency>

        <!--
           elasticloadbalancingv2 — Elastic Load Balancing (versión moderna)
           "v2" porque soporta Application Load Balancer (moderno).
           La v1 es Classic LB (obsoleto — no usar en proyectos nuevos).
           Clases: ElasticLoadBalancingV2Client, CreateLoadBalancerRequest, etc.
       -->

        <dependency>
            <groupId>software.amazon.awssdk</groupId>
            <artifactId>elasticloadbalancingv2</artifactId>
        </dependency>

        <!--
            sts — AWS Security Token Service
            Para: verificar credenciales, asumir roles IAM.
            En nuestro proyecto: usado en el health check para verificar conectividad con AWS.
        -->

        <dependency>
            <groupId>software.amazon.awssdk</groupId>
            <artifactId>sts</artifactId>
        </dependency>

        <!--
           rds — Amazon Relational Database Service
           Para: gestionar instancias RDS programáticamente (listar, snapshots, estado).
           NO es para hacer queries SQL — eso lo hace JDBC vía spring-boot-starter-data-jpa.
           Usar solo cuando necesitás automatizar operaciones de infraestructura de BD.
       -->

        <dependency>
            <groupId>software.amazon.awssdk</groupId>
            <artifactId>rds</artifactId>
        </dependency>

        <!-- ================================================================ -->
        <!--! SWAGGER / OPENAPI — DOCUMENTACIÓN AUTOMÁTICA DE LA API          -->
        <!-- ================================================================ -->

        <!--
           springdoc-openapi-starter-webmvc-ui
           Genera documentación Swagger automáticamente a partir de tus controllers.
           Disponible en: http://localhost:8080/swagger-ui.html
           Muy valorado en entrevistas — muestra que sabés documentar APIs.
       -->
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
            <version>2.6.0</version>
        </dependency>

        <!-- ================================================================ -->
        <!--! UTILIDADES                                                       -->
        <!-- ================================================================ -->

        <!--
            lombok
            Elimina boilerplate de Java con anotaciones:
            @Getter/@Setter:  genera getters y setters automáticamente
            @RequiredArgsConstructor: genera constructor con campos final
            @Slf4j:           crea Logger log = LoggerFactory.getLogger(...)
            @Builder:         patrón Builder automático
            scope=provided: solo al compilar, no se incluye en el JAR final.
        -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>
        <!--
           bucket4j-core
           Implementa el algoritmo Token Bucket para rate limiting.
           Permite limitar cuántas requests puede hacer cada usuario por minuto.
           Crítico para apps con AI — evita que un usuario gaste todo el presupuesto.
       -->
        <dependency>
            <groupId>com.bucket4j</groupId>
            <artifactId>bucket4j-core</artifactId>
            <version>8.10.1</version>
        </dependency>

        <!--
            caffeine
            Cache en memoria de alto rendimiento (el más rápido para la JVM).
            Spring Cache lo detecta automáticamente cuando está en el classpath.
            Se usa para cachear respuestas de AI y evitar llamadas repetidas.
        -->
        <dependency>
            <groupId>com.github.ben-manes.caffeine</groupId>
            <artifactId>caffeine</artifactId>
        </dependency>

        <!-- ================================================================ -->
        <!--! TESTS                                                            -->
        <!-- ================================================================ -->

        <!--
            spring-boot-starter-test
            Para escribir tests unitarios e integración:
              JUnit 5:     framework de testing estándar de Java
              Mockito:     simular objetos (mocks) en los tests
              Spring Test: levantar el contexto de Spring en tests
              AssertJ:     assertions fluidas y legibles
            scope=test: solo al correr tests, no en producción.
        -->

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>

        <!--
        spring-ai-test
        Herramientas de testing específicas para Spring AI:
        MockChatModel: simula el modelo AI en tests (sin hacer llamadas reales)
        -->
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-test</artifactId>
            <scope>test</scope>
        </dependency>

        <!--
            spring-security-test
            Utilidades de testing para Spring Security:
            @WithMockUser: simula un usuario autenticado en tests de controller
            SecurityMockMvcRequestPostProcessors: helpers para requests con auth
            La versión la gestiona el parent de Spring Boot — no necesita <version>
        -->
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-test</artifactId>
            <scope>test</scope>
        </dependency>

        <!--
            h2
            Base de datos en memoria para los tests unitarios e integración ligera.
            NO reemplaza PostgreSQL+pgvector (H2 no soporta la extensión vector),
            pero sí sirve para testear la entidad Document y DocumentRepository
            sin levantar una base de datos real.
            La versión la gestiona el parent de Spring Boot.
        -->
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>test</scope>
        </dependency>

        <!--
            spring-boot-testcontainers
            Integración de Testcontainers con Spring Boot.
            Permite levantar contenedores Docker reales durante los tests:
              - PostgreSQL con pgvector para tests de integración de RAG
              - La extensión pgvector se habilita automáticamente
            La versión la gestiona el parent de Spring Boot.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-testcontainers</artifactId>
            <scope>test</scope>
        </dependency>

        <!--
            testcontainers: postgresql
            Driver específico de Testcontainers para PostgreSQL.
            PostgreSQLContainer levanta un Postgres real en Docker durante el test
            y lo para cuando termina — tests reproducibles y aislados.
        -->
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>postgresql</artifactId>
            <scope>test</scope>
        </dependency>

    </dependencies>

    <build>
        <plugins>
            <!--
                spring-boot-maven-plugin
                Extiende Maven con comandos de Spring Boot:
                  mvn spring-boot:run → corre la app directamente
                  mvn package         → genera un "fat JAR" ejecutable

                ¿Qué es un fat JAR?
                  Un JAR normal no incluye sus dependencias.
                  Un "fat JAR" incluye TODO: tu código + Spring Boot + Tomcat
                  + Jackson + AWS SDK + Spring AI + etc.
                  Resultado: un solo archivo .jar que llevás a cualquier servidor
                  y ejecutás con: java -jar smartdoc-ai-platform.jar
                  Sin instalar nada más que Java.
            -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <!-- Excluimos Lombok del JAR final (solo sirve al compilar) -->
                    <excludes>
                        <exclude>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                        </exclude>
                    </excludes>
                </configuration>
            </plugin>
        </plugins>
    </build>

</project>
